Options -Indexes

DirectoryIndex index.php
RewriteEngine On

# Client-side application routes must reach the front controller even when a
# stale directory with the same name exists from an older deployment.
RewriteRule ^(?:admin|jobs|blog|results|services|community|weekly-summary|faq|pages|login)(?:/.*)?$ index.php [QSA,L]

# Serve versioned frontend assets and uploaded files directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [QSA,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

