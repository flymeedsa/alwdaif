Options -Indexes -ExecCGI

<FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh|htaccess)$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  RemoveHandler .php .phtml .phar .cgi .pl .py .sh
  RemoveType .php .phtml .phar .cgi .pl .py .sh
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
  Header always set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
